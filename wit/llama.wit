package cosmonic:llama-cpp@0.8.0-control-demo.1;

/// llama.cpp's public API, `llama.h`, as WIT. Each function names the `llama.h`
/// function it wraps. They differ only where WIT needs it: resources instead of
/// pointers, `result`/`option` instead of NULL and error codes, `stream<u8>` for
/// files, and checks that turn llama.cpp's asserts into errors.
///
/// `model` is `llama_model` and its `llama_vocab`, `context` is `llama_context`,
/// `sampler` is `llama_sampler`.
interface api {
    /// `llama_model_params`. Omitted params use llama.cpp defaults.
    record model-params {
        /// Number of layers to store in VRAM; negative means all.
        n-gpu-layers: s32,
    }

    /// Options for creating a context (`llama_context_params`). Omitted params
    /// use llama.cpp defaults.
    record context-params {
        /// Size of the context window in tokens (prompt + generation). `0`
        /// uses `model.n-ctx-train`.
        n-ctx: u32,
        /// Max tokens per `decode` call. Must not be `0`.
        n-batch: u32,
        /// Max tokens per micro-batch inside a `decode`. Non-causal models,
        /// such as most embedding models, need a whole input in one, so set it
        /// to `n-batch` for them. `0` uses `n-batch`.
        n-ubatch: u32,
        /// Output embeddings instead of logits; see `context.get-embeddings-ith`.
        embeddings: bool,
    }

    /// `llama_pooling_type`.
    enum pooling-type {
        unspecified,
        none,
        mean,
        cls,
        last,
        rank,
    }

    /// `llama_logit_bias`.
    record logit-bias {
        token: u32,
        bias: f32,
    }

    /// `llama_chat_message`.
    record chat-message {
        /// Typically "system", "user", or "assistant".
        role: string,
        content: string,
    }

    /// `llama_chat_apply_template`: formats `chat` with `tmpl`, such as one
    /// from `model.chat-template`. With `add-ass` it ends with the prompt for
    /// the assistant's reply. Fails if llama.cpp does not recognise `tmpl`.
    chat-apply-template: func(tmpl: string, chat: list<chat-message>, add-ass: bool) -> result<string, string>;

    /// A loaded model and its vocabulary. Any number of contexts can be created
    /// from one model.
    resource model {
        /// `llama_model_load_from_file_ptr`, over a stream of the bytes of a
        /// GGUF file so the provider does no filesystem I/O. The file is read
        /// in order and never held in memory whole, so models larger than
        /// linear memory load. `size` is the file's length in bytes, which a
        /// stream does not carry.
        create: static async func(data: stream<u8>, size: u64, params: option<model-params>) -> result<model, string>;

        /// `llama_tokenize`. `add-special` adds the model's start tokens (such
        /// as BOS); `parse-special` turns special-token text into those tokens.
        tokenize: func(text: string, add-special: bool, parse-special: bool) -> result<list<u32>, string>;

        /// `llama_detokenize`. Bytes that are not valid UTF-8, such as a
        /// character cut off at the end of `tokens`, come back as U+FFFD; to
        /// stream text, collect `token-to-piece` bytes instead.
        detokenize: func(tokens: list<u32>, remove-special: bool, unparse-special: bool) -> result<string, string>;

        /// `llama_token_to_piece`: the raw bytes of `token`, which may be part
        /// of a UTF-8 character. `lstrip` skips up to that many leading spaces;
        /// with `special`, control tokens render as their text.
        token-to-piece: func(token: u32, lstrip: s32, special: bool) -> result<list<u8>, string>;

        /// `llama_vocab_is_eog`.
        is-eog: func(token: u32) -> bool;

        /// `llama_model_chat_template`: the template called `name`, or the
        /// default one; `none` if the model has none.
        chat-template: func(name: option<string>) -> option<string>;

        /// `llama_model_desc`.
        description: func() -> string;

        /// `llama_model_n_ctx_train`.
        n-ctx-train: func() -> u32;

        /// `llama_model_n_embd_out`: the length of `context.get-embeddings-ith`
        /// vectors.
        n-embd-out: func() -> u32;

        /// Length of a `rank` pooled output (`llama_model_n_cls_out`).
        n-cls-out: func() -> u32;

        /// Number of tokens in the vocabulary (`llama_vocab_n_tokens`).
        n-vocab: func() -> u32;

        /// Size of the sliding attention window, `0` without one
        /// (`llama_model_n_swa`).
        n-swa: func() -> u32;
    }

    /// Inference state over a model (`llama_context`): holds the KV cache, so
    /// decoded tokens persist and generation continues from where the context
    /// left off.
    ///
    /// Positions and sequence ids are `llama_pos` and `llama_seq_id`; `decode`
    /// only writes sequence 0.
    ///
    /// The context keeps its model loaded, even after the model handle is dropped.
    resource context {
        /// `llama_init_from_model`.
        create: static async func(model: borrow<model>, params: option<context-params>) -> result<context, string>;

        /// `llama_n_ctx`.
        n-ctx: func() -> u32;
        /// `llama_n_batch`.
        n-batch: func() -> u32;
        /// `llama_n_ubatch`.
        n-ubatch: func() -> u32;
        /// `llama_pooling_type`.
        pooling-type: func() -> pooling-type;

        /// `llama_decode(ctx, llama_batch_get_one(tokens))`: appends `tokens`
        /// to sequence 0, after its last position. Without `embeddings`, only
        /// the last token gets logits to sample from.
        ///
        /// Fails with llama_decode's code: `1` no room in the KV cache (the
        /// context is unchanged), `2` aborted, `-1` invalid input (including
        /// more than `n-batch` tokens, or more than `n-ubatch` for a
        /// non-causal model), `< -1` fatal. On `2` and `< -1`, tokens already
        /// processed stay in the memory.
        decode: async func(tokens: list<u32>) -> result<_, s32>;

        /// `llama_memory_clear`. With `data` the buffers are zeroed too.
        memory-clear: func(data: bool);

        /// `llama_memory_seq_rm`: removes positions `[p0, p1)` of `seq-id`.
        /// `seq-id < 0` matches any sequence, `p0 < 0` means 0, `p1 < 0` means
        /// to the end. Returns false if a partial sequence cannot be removed,
        /// or for `seq-id < 0` on a recurrent model; use `memory-clear` there.
        /// With sliding-window attention, a kept prefix of `n` tokens is only
        /// usable while `memory-seq-pos-min` is at most `n - n-swa`.
        memory-seq-rm: func(seq-id: s32, p0: s32, p1: s32) -> bool;

        /// `llama_memory_seq_pos_min`: the smallest position held for
        /// `seq-id`, or `-1` if it is empty or invalid. Non-zero once sliding-window
        /// attention has dropped old tokens.
        memory-seq-pos-min: func(seq-id: s32) -> s32;

        /// `llama_memory_seq_pos_max`: the largest position held for `seq-id`,
        /// or `-1` if it is empty or invalid.
        memory-seq-pos-max: func(seq-id: s32) -> s32;

        /// `llama_get_embeddings_ith`: the embedding of the `i`th token of the
        /// last `decode`, `n-embd-out` long. Negative `i` counts from the end.
        /// `none` for an invalid `i`, a context without `embeddings`, or pooling
        /// other than `none`.
        get-embeddings-ith: func(i: s32) -> option<list<f32>>;

        /// `llama_get_embeddings_seq`: the pooled embedding of `seq-id`,
        /// `n-embd-out` long, or `n-cls-out` long for `rank` pooling. `none` with
        /// pooling `none`.
        get-embeddings-seq: func(seq-id: s32) -> option<list<f32>>;
    }

    /// `llama_sampler`. Build a chain with `chain-init` and `chain-add`, as in
    /// llama.cpp; generation is a caller-side loop:
    ///
    ///   let tok = chain.sample(ctx, -1)?;     // pick from the last logits
    ///   if model.is-eog(tok) { done }
    ///   bytes += model.token-to-piece(tok, 0, false);
    ///   ctx.decode([tok]);                    // makes the next logits
    ///
    /// A sampler made from a model keeps that model loaded.
    resource sampler {
        /// `llama_sampler_chain_init`.
        chain-init: static func() -> sampler;

        /// `llama_sampler_chain_add`: appends `smpl`, which the chain then
        /// owns. Fails, dropping `smpl`, if this sampler is not a chain or the
        /// two were made for different models.
        chain-add: func(smpl: sampler) -> result<_, string>;

        /// `llama_sampler_init_greedy`.
        init-greedy: static func() -> sampler;

        /// `llama_sampler_init_dist`. `4294967295` picks a random seed.
        init-dist: static func(seed: u32) -> sampler;

        /// `llama_sampler_init_top_k`. `k <= 0` disables.
        init-top-k: static func(k: s32) -> sampler;

        /// `llama_sampler_init_top_p`.
        init-top-p: static func(p: f32, min-keep: u32) -> sampler;

        /// `llama_sampler_init_min_p`.
        init-min-p: static func(p: f32, min-keep: u32) -> sampler;

        /// `llama_sampler_init_temp`. `t <= 0` keeps only the most likely token.
        init-temp: static func(t: f32) -> sampler;

        /// `llama_sampler_init_penalties`, with `n_vocab` from `model`.
        /// `penalty-last-n` is how many recent tokens to look at (`0`
        /// disables); `1`, `0` and `0` disable the three penalties. The window
        /// is allocated up front, so keep it within the context size.
        init-penalties: static func(model: borrow<model>, penalty-last-n: s32, penalty-repeat: f32, penalty-freq: f32, penalty-present: f32) -> sampler;

        /// `llama_sampler_init_logit_bias`, with `n_vocab` from `model`.
        /// Biases for tokens outside the vocabulary are dropped.
        init-logit-bias: static func(model: borrow<model>, logit-bias: list<logit-bias>) -> sampler;

        /// `llama_sampler_init_grammar`: restricts output to the GBNF grammar
        /// `grammar-str`, starting from rule `grammar-root`. Fails if the
        /// grammar does not parse; an empty `grammar-str` constrains nothing. `json-schema.to-grammar` makes one from a
        /// JSON Schema.
        init-grammar: static func(model: borrow<model>, grammar-str: string, grammar-root: string) -> result<sampler, string>;

        /// `llama_sampler_sample`: samples and accepts a token from the
        /// `idx`th output of the last `decode`; `-1` is the last one. Fails if
        /// that output has no logits, if the sampler was made for another model
        /// than the context's, if no sampler in the chain picks a token,
        /// or if the pick is one an earlier sampler ruled out (such as a
        /// grammar placed after `top-k`).
        sample: async func(ctx: borrow<context>, idx: s32) -> result<u32, string>;
    }
}

/// Implemented by the llama-cpp-wit component.
world provider {
    export api;
}

/// For components consuming the interface (e.g. the chat CLI).
world consumer {
    import api;
}

world test-harness {
    import api;
    export list-tests: func() -> list<string>;
    export run-test: async func(name: string) -> result<_, string>;
}
