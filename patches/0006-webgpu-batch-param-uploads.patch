+    // Params are staged here and uploaded once per batch (see flush). Slots are
+    // handed out sequentially from 0 after each reset, so the used region is
+    // always contiguous and a single write covers it.
+    void stage(size_t offset, const void * data, size_t size) {
+        if (staging.size() < slot_stride * slot_count) {
+            staging.resize(slot_stride * slot_count);
+        }
+        memcpy(staging.data() + offset, data, size);
+    }
+
+    // Upload before the batch's commands are submitted: queue writes and submits
+    // are ordered on the queue, so the data is in place when the kernels run.
+    void flush(wgpu::Queue & queue) {
+        if (next_slot == 0) {
+            return;
+        }
+        queue.WriteBuffer(buffer, 0, staging.data(), slot_stride * next_slot);
+    }
+
     void reset() { next_slot = 0; }
 
+    std::vector<uint8_t> staging;
+
     void cleanup() {
         if (buffer) {
             buffer.Destroy();
