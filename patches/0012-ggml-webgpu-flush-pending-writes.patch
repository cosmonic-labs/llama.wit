+// queue.WriteBuffer does not touch the destination buffer: it copies the source
+// into the queue's pending writes, which only reach the buffer at the next
+// submit. Loading a model issues no submits at all -- nothing is computed until
+// the weights are up -- so every byte is held twice, once in its destination
+// buffer and once in staging, and peak memory measures ~2.15x the model. That
+// is what puts a 13 GiB model over a 32 GiB machine while a 10 GiB one fits.
+//
+// Submitting an empty command buffer flushes the pending writes and releases
+// the staging memory. Do it every so many bytes so staging stays bounded and
+// peak tracks the model rather than twice the model. The threshold only has to
+// be small against the memory it saves and large against a submit's cost; a
+// 13 GiB load flushes ~50 times.
+//
+// Submitting zero commands would flush too, but the wasi glue's wgpuQueueSubmit
+// mallocs for the command list and treats a null return as OOM, and malloc(0)
+// is allowed to return null. An empty encoder avoids relying on that.
+static void ggml_webgpu_flush_writes(webgpu_global_context ctx, size_t bytes) {
+    static constexpr uint64_t FLUSH_THRESHOLD = 256ull << 20;  // 256 MiB
+
+    ctx->bytes_since_submit += bytes;
+    if (ctx->bytes_since_submit < FLUSH_THRESHOLD) {
+        return;
+    }
+    wgpu::CommandEncoder encoder  = ctx->device.CreateCommandEncoder();
+    wgpu::CommandBuffer  commands = encoder.Finish();
+    ctx->queue.Submit(1, &commands);
+    ctx->bytes_since_submit = 0;
+}
