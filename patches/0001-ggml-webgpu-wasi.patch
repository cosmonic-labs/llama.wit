diff --git a/ggml/src/ggml-webgpu/CMakeLists.txt b/ggml/src/ggml-webgpu/CMakeLists.txt
index 1503a1ef8..559efffd5 100644
--- a/ggml/src/ggml-webgpu/CMakeLists.txt
+++ b/ggml/src/ggml-webgpu/CMakeLists.txt
@@ -59,6 +59,34 @@ if(EMSCRIPTEN)
         target_compile_options(ggml-webgpu PRIVATE "-fexceptions")
         target_link_options(ggml-webgpu INTERFACE "-sASYNCIFY" "-exceptions")
     endif()
+elseif(CMAKE_SYSTEM_NAME STREQUAL "WASI")
+    # WebGPU via the wasi:webgpu component-model interface: Dawn's C++ wrapper
+    # adapted for wasi (dawn_wasi_webgpu_cpp) on top of the wasi-webgpu-headers
+    # C implementation (webgpu.h lowered onto wit-bindgen'd wasi:webgpu imports).
+    set(DAWN_WASI_WEBGPU_DIR "/media/mendyberger/USB-Card/wasi/dawn_wasi_webgpu_cpp"
+        CACHE PATH "Path to dawn_wasi_webgpu_cpp (Dawn C++ webgpu.h wrapper for wasi)")
+    set(WASI_WEBGPU_HEADERS_DIR "/media/mendyberger/USB-Card/wasi/wasi-webgpu-headers"
+        CACHE PATH "Path to wasi-webgpu-headers (webgpu.h implementation over wasi:webgpu)")
+
+    # ggml includes <webgpu/webgpu_cpp.h>; the wrapper keeps its headers at the
+    # repo root, so expose them under a webgpu/ prefix via symlinks.
+    set(_wasi_webgpu_inc "${CMAKE_CURRENT_BINARY_DIR}/wasi-webgpu-include")
+    file(MAKE_DIRECTORY "${_wasi_webgpu_inc}/webgpu")
+    foreach(hdr webgpu_cpp.h webgpu_cpp_chained_struct.h webgpu_enum_class_bitmasks.h)
+        file(CREATE_LINK "${DAWN_WASI_WEBGPU_DIR}/${hdr}" "${_wasi_webgpu_inc}/webgpu/${hdr}" SYMBOLIC)
+    endforeach()
+
+    target_sources(ggml-webgpu PRIVATE
+        "${WASI_WEBGPU_HEADERS_DIR}/webgpu.c"
+        "${WASI_WEBGPU_HEADERS_DIR}/async_futures.c"
+        "${WASI_WEBGPU_HEADERS_DIR}/imports.c"
+        "${WASI_WEBGPU_HEADERS_DIR}/imports_component_type.o"
+    )
+    target_include_directories(ggml-webgpu PRIVATE
+        "${_wasi_webgpu_inc}"
+        "${WASI_WEBGPU_HEADERS_DIR}"
+    )
+    set(DawnWebGPU_TARGET "")
 else()
     find_package(Dawn REQUIRED)
     set(DawnWebGPU_TARGET dawn::webgpu_dawn)
